  nodes:
  - id: opening
    lines:
    - characterId: anh_khoa_tren
      pose: 1
      text: "Ch\xE0o t\xE2n binh :eyes: S\xE2n tr\u01B0\u1EDDng d\xE0i bao nhi\xEAu
        h\u1EA3? \u0110\u1EE3i bu\u1ED5i th\u1EC3 ch\u1EA5t \u0111\u1EA7u ti\xEAn
        l\xE0 bi\u1EBFt li\u1EC1n :skull:"
      sticker: 
    - characterId: mai_toang
      pose: 2
      text: "\u1ED4ng d\u1ECDa t\u1EE5i m\xECnh k\xECa :sob: M\u1EDBi nh\u1EADp h\u1ECDc
        m\xE0 \u0111\xE3 th\u1EA5y m\xF9i toang r\u1ED3i \u0111\xF3."
      sticker: "\xC9T O \xC9T!"
    - characterId: tan_thu
      pose: 0
      text: "B\xECnh t\u0129nh. Qua m\xF4n tr\u01B0\u1EDBc, flex t\xEDnh sau :sunglasses:"
      sticker: 
    - characterId: co_the_chat
      pose: 0
      text: "L\u1ED9 tr\xECnh: ch\u1EA1y n\u01B0\u1EDBc r\xFAt, r\u1ED3i b\xF3ng
        chuy\u1EC1n, r\u1ED3i b\xF3ng \u0111\xE1. Qua m\xF4n tr\u01B0\u1EDBc m\u1EDBi
        m\u1EDF kh\xF3a m\xF4n sau nha c\xE1c em :salute:"
      sticker: 
  - id: sprint_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Kh\u1EDFi \u0111\u1ED9ng b\u1EB1ng nh\u1ECBp ch\xE2n. Tr\xE1i, ph\u1EA3i,
        tr\xE1i, ph\u1EA3i. \u0110\u1EC1u nh\u01B0 nh\u1ECBp tim crush l\xFAc nh\u1EAFn
        \"seen\" :eyes:"
      sticker: 
    - characterId: mai_toang
      pose: 2
      text: "\xC9t o \xE9t :sob: 12 nh\u1ECBp li\u1EC1n m\u1EA1ch, sai m\u1ED9t ph\xE1t
        l\xE0 l\xE0m l\u1EA1i t\u1EEB \u0111\u1EA7u \u0111\xF3 b\xE0 con \u01A1i!"
      sticker: TOANG?!
    - characterId: tan_thu
      pose: 0
      text: "Ch\xE2n tr\xE1i, ch\xE2n ph\u1EA3i th\xF4i m\xE0. Ch\u1EA1y nh\u01B0
        ch\u01B0a t\u1EEBng \u0111\u01B0\u1EE3c ch\u1EA1y :runner::dash:"
      sticker: 
  - id: sprint_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "B\xE0i thi: 150 m\xE9t trong 22 gi\xE2y. Gi\u1EEF s\u1EE9c, \u0111\u1EEBng
        bung h\u1EBFt t\u1EEB v\u1EA1ch xu\u1EA5t ph\xE1t nha :fire:"
      sticker: "22 GI\xC2Y"
    - characterId: tan_thu
      pose: 3
      text: "T\u1EADp r\u1ED3i, gi\u1EDD thi th\xF4i. \u0110\u01B0\u1EDDng \u0111ua
        \u01A1i, ch\u1EDD anh :100:"
      sticker: 
  - id: sprint_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t! Nh\u1ECBp ch\xE2n \u1ED5n \xE1p r\u1ED3i \u0111\xF3.
        C\xF4 c\xF4ng nh\u1EADn em h\u01A1i b\u1ECB \u0111\u1EC9nh n\xF3c :fire:"
      sticker: "\u0110\u1EA0T!"
    - characterId: mai_toang
      pose: 1
      text: "S\xE2n tr\u01B0\u1EDDng v\u1EABn d\xE0i, nh\u01B0ng gi\u1EDD m\xECnh
        ch\u1EA1y h\u1EBFt n\u1ED5i r\u1ED3i :sob::tada:"
      sticker: 
  - id: volleyball_intro
    lines:
    - characterId: mai_toang
      pose: 1
      text: "B\xF3ng chuy\u1EC1n n\xE8! \u0110\u1EE1 b\xF3ng \u0111\xFAng t\u1EA7m
        tr\u01B0\u1EDBc, chuy\u1EC1n \u0111\u1EB9p t\xEDnh sau :volleyball:"
      sticker: 
    - characterId: co_the_chat
      pose: 0
      text: "\u0110\u1EE1, chuy\u1EC1n, \u0111\u1EADp, \u0111\u1EE7 ba ch\u1EA1m.
        B\xF3ng r\u01A1i xu\u1ED1ng s\xE2n m\xECnh l\xE0 m\u1EA5t \u0111i\u1EC3m,
        kh\xF4ng c\xF3 chuy\u1EC7n \"ch\u01B0a s\u1EB5n s\xE0ng\" \u0111\xE2u :eyes:"
      sticker: 
    - characterId: tan_thu
      pose: 4
      text: "Ba \u0111\u01B0\u1EDDng b\xF3ng li\u1EC1n :scream: Th\xF4i \u0111\u01B0\u1EE3c,
        tay em \u0111\xE2y, c\u1EE9 ph\xE1t b\xF3ng \u0111i!"
      sticker: "C\u1EE8U!"
  - id: volleyball_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Thi \u0111\u1EA5u: ai ghi \u0111\u1EE7 10 \u0111i\u1EC3m tr\u01B0\u1EDBc
        th\xEC th\u1EAFng :fire:"
      sticker: "10 \u0110I\u1EC2M"
    - characterId: mai_toang
      pose: 3
      text: "Tui \u0111\u1EE1 th\u1EADt \u0111\u1EB9p, \xF4ng lo c\xFA \u0111\u1EADp
        nha. \u0110\u1EEBng \u0111\u1EC3 tui ph\u1EA3i \xE9t o \xE9t :sob:"
      sticker: 
    - characterId: tan_thu
      pose: 1
      text: "Combo \u0111\u1EE1, chuy\u1EC1n, \u0111\u1EADp, nh\u1EADn v\u1EC1 10
        \u0111i\u1EC3m :100:"
      sticker: 
  - id: volleyball_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t! Ph\u1ED1i h\u1EE3p m\u01B0\u1EE3t nh\u01B0 wifi th\u01B0
        vi\u1EC7n l\xFAc 6 gi\u1EDD s\xE1ng :volleyball:"
      sticker: "\u0110\u1EA0T!"
    - characterId: tan_thu
      pose: 3
      text: "C\u1EA3m \u01A1n \u0111\u1ED3ng \u0111\u1ED9i :salute: Hai m\xF4n r\u1ED3i,
        m\xF4n cu\u1ED1i \u0111\xE2u, ra \u0111\xE2y!"
      sticker: 
  - id: soccer_intro
    lines:
    - characterId: mai_toang
      pose: 0
      text: "C\xF2n m\xF4n cu\u1ED1i th\xF4i. B\xECnh t\u0129nh, qu\u1EA3 b\xF3ng
        kh\xF4ng c\xF3 deadline \u0111\xE2u :soccer:"
      sticker: 
    - characterId: anh_khoa_tren
      pose: 1
      text: "H\u1ED3i anh thi, th\u1EE7 m\xF4n cao hai m\xE9t, s\xE2n d\u1ED1c l\xEAn
        tr\u1EDDi :skull: Em gi\u1EDD s\u01B0\u1EDBng ch\xE1n."
      sticker: "H\u1ED2I \u0110\xD3\u2026"
    - characterId: co_the_chat
      pose: 0
      text: "\u0110\u1EEBng nghe \u1ED5ng ch\xE9m :clown: T\u1EADp h\u01B0\u1EDBng
        s\xFAt v\xE0 l\u1EF1c s\xFAt tr\u01B0\u1EDBc. L\xFAc thi em c\xF3 \u0111\xFAng
        5 c\xFA."
      sticker: 
  - id: soccer_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Thi: 5 c\xFA s\xFAt, v\xE0o \xEDt nh\u1EA5t 3 b\xE0n l\xE0 qua. Th\u1EE7
        m\xF4n h\xF4m nay kh\xF4ng n\u01B0\u01A1ng tay \u0111\xE2u :eyes:"
      sticker: "5 C\xDA"
    - characterId: tan_thu
      pose: 0
      text: "Nh\u1EAFm ch\u1EAFc, l\u1EF1c v\u1EEBa \u0111\u1EE7, s\xFAt l\xE0 v\xE0o.
        Ch\xE2n n\xE0y \u0111\xE3 \u0111\u01B0\u1EE3c khai quang :fire:"
      sticker: 
  - id: soccer_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t ba m\xF4n! C\xF2n \u0111\xFAng m\u1ED9t b\xE0i ki\u1EC3m
        tra cu\u1ED1i v\u1EDBi c\xF4 n\u1EEFa th\xF4i :eyes:"
      sticker: "\u0110\u1EA0T!"
    - characterId: mai_toang
      pose: 1
      text: "QUA R\u1ED2I :sob::sob: C\xF2n b\xE0i cu\u1ED1i, \xF4ng r\xE1ng n\u1ED1t
        nha!"
      sticker: 
  - id: chess_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "B\xE0i cu\u1ED1i kh\xF4ng ch\u1EA1y, kh\xF4ng nh\u1EA3y. C\xF4 \u0111\u1EB7t
        m\u1ED9t th\u1EBF c\u1EDD, em chi\u1EBFu h\u1EBFt trong hai n\u01B0\u1EDBc
        :eyes:"
      sticker: "B\xC0I CU\u1ED0I"
    - characterId: tan_thu
      pose: 2
      text: "Th\u1EC3 ch\u1EA5t m\xE0 thi c\u1EDD vua \u1EA1? Em t\u01B0\u1EDFng
        c\xF4 ch\u1EC9 bi\u1EBFt th\u1ED5i c\xF2i :sob:"
      sticker: 
    - characterId: co_the_chat
      pose: 0
      text: "C\xF2i v\u1EABn mang theo \u0111\xE2y. \u0110i sai l\xE0 c\xF4 th\u1ED5i.
        Em c\xF3 90 gi\xE2y, sai t\u1ED1i \u0111a hai l\u1EA7n :fire:"
      sticker: "90 GI\xC2Y"
  - id: supplementary
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Ch\u01B0a qua th\xEC \xF4n l\u1EA1i b\xE0i luy\u1EC7n r\u1ED3i thi ti\u1EBFp.
        Ph\u1EA7n \u0111\xE3 \u0111\u1EA1t v\u1EABn \u0111\u01B0\u1EE3c gi\u1EEF
        nguy\xEAn, kh\xF4ng m\u1EA5t g\xEC \u0111\xE2u :salute:"
      sticker: 
    - characterId: mai_toang
      pose: 2
      text: "Toang nh\u1EB9 th\xF4i, ch\u01B0a toang h\u1EB3n :clown: Luy\u1EC7n
        \u0111\xFAng ch\u1ED7 c\xF2n v\u01B0\u1EDBng r\u1ED3i qu\u1EA9y l\u1EA1i
        nha!"
      sticker: "H\u1ED2I SINH!"
  - id: course_complete
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "Ch\xFAc m\u1EEBng! H\u1ECDc ph\u1EA7n Th\u1EC3 ch\u1EA5t ch\xEDnh th\u1EE9c
        ho\xE0n t\u1EA5t :tada:"
      sticker: "HO\xC0N TH\xC0NH!"
    - characterId: tan_thu
      pose: 3
      text: "T\u1EEB t\xE2n binh run run th\xE0nh tuy\u1EC3n th\u1EE7 c\u1EA5p tr\u01B0\u1EDDng.
        Flex \u0111\u01B0\u1EE3c r\u1ED3i \u0111\xFAng kh\xF4ng? :sunglasses:"
      sticker: 
    - characterId: anh_khoa_tren
      pose: 1
      text: "\u0110\u01B0\u1EE3c! Nh\u01B0ng n\u0103m sau nh\u1EDB d\u1ECDa kh\xF3a
        d\u01B0\u1EDBi y nh\u01B0 anh nha :skull:"
      sticker: 
    - characterId: mai_toang
      pose: 1
      text: "H\u1ED9i qua m\xF4n Th\u1EC3 ch\u1EA5t, \u0111i\u1EC3m danh :100::tada:
        :muscle:"
      sticker: 
